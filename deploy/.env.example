# ============================================================
# HVV Major 自托管后端环境变量
# 复制为 .env 后，把所有 <...> 占位符换成随机值
# 生成随机值：openssl rand -hex 32
# ============================================================

# 服务器对外地址（前端 VITE_SUPABASE_URL 也用这个）
SITE_URL=http://<你的服务器IP>:8000
# 允许访问的源（前端部署地址，逗号分隔）
URI_ALLOW_LIST=http://<你的服务器IP>:8000,http://localhost:5173,https://major.hwmajor.club

# ===== 三个必须一致的 JWT_SECRET（GoTrue/PostgREST/Realtime 共用）=====
JWT_SECRET=<openssl rand -hex 64 的结果>

# ===== 数据库密码 =====
# postgres 超级用户
POSTGRES_PASSWORD=<随机32位>
# authenticator 角色（PostgREST 连接用）
AUTHENTICATOR_PASSWORD=<随机32位>
# supabase_auth_admin 角色（GoTrue 连接用）
AUTH_DB_PASSWORD=<随机32位>
# supabase_realtime_admin 角色（Realtime 连接用）
REALTIME_DB_PASSWORD=<随机32位>

# 邮箱验证：true=注册即通过(内部赛事够用，省 SMTP)；false=需配 SMTP 发验证邮件
MAILER_AUTOCONFIRM=true
